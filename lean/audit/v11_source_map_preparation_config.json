  "explicit_source_claim_atoms": {
    "proposition_1_global_solution_regimes": [
      {
        "id": "proposition1.global_optimizer_and_formulas",
        "source_locator": "source.txt:349-370",
        "verbatim_source_clause": "Proposición 1 (Solución global y pendientes por régimen). Bajo los Supuestos 1–3, existe un\núnico máximo en (2). Es\n\u001a\n\u001b\n\u001a\n\u001a\n\u001b\u001b\ngR(D)\nq 0 (D)\ngR(D)\n∗\n0\n∗\ne = mı́n\n, ē,\n,\nq = máx 0, q (D) − g mı́n ē,\n.\n(3)\nc\ng\nc",
        "semantic_claim": "Under Assumptions 1–3 the conditioned continuation problem has a unique global maximizer; optimal effort is min(g R(D) / c, ebar, q0(D) / g), and optimal risk is max(0, q0(D) - g * min(ebar, g R(D) / c))."
      },
      {
        "id": "proposition1.strict_regime_derivatives",
        "source_locator": "source.txt:371-385",
        "verbatim_source_clause": "Para κ ﬁjo, en cualquier intervalo abierto con desigualdades estrictas que mantengan el régimen,\nlas pendientes son\n\na − g 2 /c, gR/c < ē y gR/c < q 0 /g,\n∂q ∗ \n= a,\n(4)\nē < gR/c y ē < q 0 /g,\n\n∂D\n\n0\n0\n0,\nq /g < gR/c y q /g < ē.",
        "semantic_claim": "On every open interval where the strict inequalities preserve a regime, the derivative of optimal risk with respect to D is respectively a - g^2/c in the interior-effort regime, a in the capacity-binding regime, and 0 in the risk-floor regime."
      },
      {
        "id": "proposition1.zero_capacity",
        "source_locator": "source.txt:386",
        "verbatim_source_clause": "Si ē = 0, e∗ = 0 y q ∗ = q 0 , con pendiente a en el interior del dominio de D.",
        "semantic_claim": "When screening capacity ebar is zero, optimal effort is zero, optimal risk equals prior risk q0, and its derivative is a in the interior of the D domain."
      },
      {
        "id": "proposition1.ties_continuity_and_lateral_derivatives",
        "source_locator": "source.txt:386-388",
        "verbatim_source_clause": "En empates de\nrestricciones la solución es continua y se usan derivadas laterales; una derivada ordinaria puede\nno existir.",
        "semantic_claim": "At ties between constraints the solution is continuous and is governed by one-sided derivatives; an ordinary derivative may fail to exist."
      }
    ],
    "proposition_2_conditional_threshold": {
      "id": "proposition2.unique_conditional_threshold",
      "source_locator": "source.txt:484-485",
      "verbatim_source_clause": "Proposición 2 (Umbral condicional). Bajo los Supuestos 1–4, existe un único κ∗ ∈ (0, 1) con\n∂D q ∗ (D0 , κ∗ ) = 0. La derivada es positiva para κ < κ∗ y negativa para κ > κ∗ .",
      "semantic_claim": "Under Assumptions 1–4 there is a unique kappa* in (0,1) at which the D-derivative of optimal risk at D0 is zero; that derivative is positive below kappa* and negative above it."
    },
    "proposition_3_transmission_composition": [
      {
        "id": "proposition3.portfolio_ledger_identity",
        "source_locator": "source.txt:540-541",
        "verbatim_source_clause": "Proposición 3 (Transmisión y composición). Bajo los Supuestos 1–3 y 5, el ratio esperado de\ncartera es M (D) = (1 − w)m0 + wq ∗ (D). En cualquier régimen diferenciable, escribiendo βD =",
        "semantic_claim": "Under Assumptions 1–3 and 5, the expected portfolio ratio is M(D) = (1-w(D)) m0 + w(D) q*(D)."
      },
      {
        "id": "proposition3.general_derivative",
        "source_locator": "source.txt:542-544",
        "verbatim_source_clause": "∂D q ∗ (D),\nM ′ (D) = wβD + w′ (q ∗ − m0 ).\n(6)",
        "semantic_claim": "In every differentiable regime, writing beta_D for the D-derivative of q*, the derivative of the portfolio ratio is M' = w beta_D + w' (q* - m0)."
      },
      {
        "id": "proposition3.sign_preservation_rules",
        "source_locator": "source.txt:545-546",
        "verbatim_source_clause": "Si B es constante, el signo es el de βD . Si βD ̸= 0 y |w′ (q ∗ − m0 )| < w|βD |, el signo también se\nconserva.",
        "semantic_claim": "If the new-cohort balance B is constant, M' has the sign of beta_D; if beta_D is nonzero and the absolute composition term is strictly smaller than w |beta_D|, that sign is also preserved."
      },
      {
        "id": "proposition3.exponential_balance_derivative",
        "source_locator": "source.txt:546-549",
        "verbatim_source_clause": "Con B(D) = B1 e−εD , B1 > 0, ε ≥ 0,\nM ′ = w{βD − ε(1 − w)(q ∗ − m0 )}.\n\n(7)",
        "semantic_claim": "For B(D) = B1 exp(-epsilon D), with B1 > 0 and epsilon >= 0, M' = w { beta_D - epsilon (1-w) (q* - m0) }."
      },
      {
        "id": "proposition3.composition_reversal_iff",
        "source_locator": "source.txt:551",
        "verbatim_source_clause": "En particular, βD > 0 y q ∗ > m0 generan M ′ < 0 si y solo si ε(1 − w)(q ∗ − m0 ) > βD .",
        "semantic_claim": "In particular, when beta_D > 0 and q* > m0, M' < 0 if and only if epsilon (1-w) (q* - m0) > beta_D."
      }
    ]
  },
