# Preserve every generated byte, including evidence hashes and line endings.
/paper/*.tex text eol=lf
/paper/*.bib text eol=lf
/paper/*.pdf -text
/lean/** -text whitespace=cr-at-eol
/docs/lean_evidence/*.lean text eol=lf
/docs/lean_evidence/*.json text eol=lf
/docs/lean_evidence/original_adversarial_panel.json -text whitespace=cr-at-eol
/docs/lean_evidence/frozen_source/** -text whitespace=cr-at-eol
